      "type": "UNETLoader",
      "pos": [50, 350],
      "size": [315, 80],
      "title": "Z-Image UNet 6B",
      "properties": {},
      "widgets_values": ["z_image_bf16.safetensors", "default"],
      "outputs": [{"name": "MODEL", "type": "MODEL", "links": [1]}]
    },
