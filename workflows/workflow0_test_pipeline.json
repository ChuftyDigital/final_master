      "type": "CLIPTextEncode",
      "pos": [450, 700],
      "size": [450, 120],
      "title": "TEST PROMPT (Positive)",
      "properties": {},
      "widgets_values": ["A masterful portrait photograph of a 26-year-old Latina woman with dark brown wavy hair with sun-lightened ends, warm dark brown eyes with golden flecks, naturally tanned golden-bronze skin. She wears a casual white button-up shirt, beach casual style. Classic head-and-shoulders portrait facing the camera directly, warm flirty smile. Lit by a large softbox at 45 degrees, white reflector below providing gentle fill. Shot on Sony A7R V with 85mm f/1.4 at f/1.8, ISO 100. Shallow depth of field with creamy bokeh. Natural skin texture with visible pores, individual hair strands catching light, realistic subsurface scattering. Photorealistic, indistinguishable from real photograph, 8K detail."],
      "inputs": [{"name": "clip", "type": "CLIP", "link": 2}],
      "outputs": [{"name": "CONDITIONING", "type": "CONDITIONING", "links": [8, 21]}]
    },
    {
      "id": 9,
      "type": "CLIPTextEncode",
      "pos": [450, 870],
      "size": [450, 80],
      "title": "NEGATIVE PROMPT",
      "properties": {},
      "widgets_values": ["cartoon, anime, illustration, painting, CGI, 3D render, low quality, blurry, distorted features, multiple people, deformed, bad anatomy, unrealistic proportions, plastic skin, artificial smoothness, overprocessed, text, watermark, signature"],
      "inputs": [{"name": "clip", "type": "CLIP", "link": 3}],
      "outputs": [{"name": "CONDITIONING", "type": "CONDITIONING", "links": [9, 22]}]
    },
