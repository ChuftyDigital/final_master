      "size": [300, 80],
      "title": "Qwen CLIP Encoder",
      "widgets_values": ["qwen_3_4b.safetensors", "lumina2"],
      "outputs": [{"name": "CLIP", "type": "CLIP", "links": [2, 3, 4]}]
    },
