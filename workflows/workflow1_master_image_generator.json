  "metadata": {
    "title": "Workflow 1 - Master Reference Image Generator",
    "description": "Generates 3 master reference images per character for LoRA training. Uses Z-Image Base (6B) with 2-step refinement pipeline (generate + latent upscale 1.5x + refine at denoise 0.2), YOLOV11m face detailing, and film grain. Optimized for RTX 5090 (32GB VRAM).",
    "version": "3.1",
    "author": "AI Influencer Pipeline",
    "gpu_target": "RTX 5090 32GB",
    "docker_image": "comfyui:latest-5090"
  },
  "nodes": [
    {
      "id": 1,
      "type": "Note",
      "pos": [50, 50],
      "size": [400, 220],
      "properties": {
        "text": "WORKFLOW 1: MASTER IMAGE GENERATOR (Z-Image Base)\n=====================================================\nGenerates 3 reference images per character:\n  - Face 01: Front-facing portrait (identity anchor)\n  - Face 02: Three-quarter angle (dimensionality)\n  - Face 03: Natural/environmental (personality)\n\n2-STEP PIPELINE:\n  Step 1: Generate at 1024x1024 (40 steps, DPM++ 2M Karras, CFG 4.5)\n  Step 2: Latent upscale 1.5x + refine (20 steps, denoise 0.2)\n  Step 3: FaceDetailer with YOLOV11m-face.pt\n  Step 4: Film grain + SeedVR2 upscale to 2048px\n\nMODEL: Z-Image Base (6B) | NOT Turbo\nOPTIMIZED FOR: RTX 5090 32GB VRAM"
      }
    },
